# 복사해서 .env 로 쓰거나 배포 환경 변수로 주입 (값은 직접 생성: python -c "import secrets;print(secrets.token_urlsafe(24))")
# 최초 기동 시 사용자가 없으면 이 계정으로 관리자 1명을 만든다 (12자 이상)
RKMSIEM_ADMIN_USER=admin
RKMSIEM_ADMIN_PASSWORD=
# HTTP 수집 API 키 (쉼표로 여러 개). 요청 헤더 X-API-Key 로 전달
RKMSIEM_INGEST_KEYS=
# 설정 덮어쓰기 예시
# RKMSIEM_API__PORT=8088
# RKMSIEM_SOAR__MODE=simulate        # live 로 바꾸면 승인된 차단/비활성화가 로컬 어댑터에 실제 반영
# RKMSIEM_DATABASE__PATH=data/rkmsiem.db
# RKMSIEM_LOG_LEVEL=INFO

# IP 평판 외부 조회 (선택) — https://www.abuseipdb.com/account/api 에서 발급
# RKMSIEM_ABUSEIPDB_KEY=
# 메일 발송 SMTP 비밀번호 (Gmail·Naver 는 앱 비밀번호) — 서버 주소·계정은 settings.yaml 의 mail
# RKMSIEM_SMTP_PASSWORD=

# 담당자 관리 앱(python -m staffdir serve) 연동 (선택) — 두 키는 같은 값
# STAFF_SYNC_KEYS=
# RKMSIEM_STAFF_SYNC_KEY=
# RKMSIEM_STAFF__URL=http://127.0.0.1:8090
# STAFF_NOTIFY_URL=http://127.0.0.1:8088/api/staff/hook
